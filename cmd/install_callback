#!/bin/bash
# Validate explicitly supplied paths only. Default locations are prepared by fnOS.
set -euo pipefail
errors=()
check_dir() {
  local label="$1" path="$2" detail
  [ -n "$path" ] || return 0
  if [[ "$path" != /* || "$path" == / || "$path" == *:* || "$path" == *$'\r'* || "$path" == *$'\n'* ]]; then
    errors+=("$label：请输入有效的宿主机目录绝对路径（不能为 / 或包含冒号）。")
  elif [ ! -d "$path" ]; then
    # A package hook may be unable to traverse a private parent directory.
    # Do not mistake that for a missing directory; Docker enforces the bind.
    if detail=$(LC_ALL=C stat -L -c '%F' -- "$path" 2>&1); then
      errors+=("$label：不是文件夹：$path")
    elif [[ "$detail" == *"No such file or directory"* || "$detail" == *"Not a directory"* ]]; then
      errors+=("$label：目录不存在或不是文件夹：$path")
    else
      printf '%s\n' "$label：暂无法确认目录状态，交由 Docker 挂载时检查：$path" >&2
    fi
  fi
}
check_dir "游戏目录" "${wizard_game_path:-}"
check_dir "临时安装包目录" "${wizard_staging_path:-}"
check_dir "应用数据目录" "${wizard_data_path:-}"
check_id() {
  local label="$1" value="$2"
  [ -n "$value" ] || return 0
  if [[ ! "$value" =~ ^[1-9][0-9]{0,9}$ ]] || [ "$value" -gt 2147483647 ]; then
    errors+=("$label：请输入 1 至 2147483647 的数字，或留空。")
  fi
}
check_id UID "${wizard_puid:-}"
check_id GID "${wizard_pgid:-}"
if [ "${#errors[@]}" -gt 0 ]; then
  printf '%s\n' "${errors[@]}" >&2
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "${errors[@]}" > "$TRIM_TEMP_LOGFILE" || true
  fi
  exit 1
fi
exit 0
