#!/bin/bash
# Adapt the tested FileView pattern: compare actual mounts, then recreate
# using the original Compose project. Do not run the engine as root.
set -euo pipefail
fail() { printf '%s\n' "$*" >&2; if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then printf '%s\n' "$*" >>"$TRIM_TEMP_LOGFILE" || true; fi; exit 1; }
: "${TRIM_APPDEST:?}" "${TRIM_UID:?}" "${TRIM_GID:?}"
[[ "$TRIM_UID" =~ ^[0-9]+$ && "$TRIM_UID" != 0 && "$TRIM_GID" =~ ^[0-9]+$ ]] || fail "Invalid application identity"
project=ps5upload-fnos
container=ps5upload-fnos
compose="$TRIM_APPDEST/docker/docker-compose.yaml"
source_path="${TRIM_DATA_ACCESSIBLE_PATHS:-${TRIM_DATA_SHARE_PATHS:-}}"
case "$source_path" in ""|*:*) fail "请选择一个游戏目录，或取消外部授权使用默认共享目录";; esac
[[ "$source_path" = /* && "$source_path" != / && "$source_path" != *$'\n'* && "$source_path" != *$'\r'* ]] || fail "Invalid directory"
[ -d "$source_path" ] && [ -r "$source_path" ] && [ -x "$source_path" ] || fail "游戏目录不存在或应用用户无读取权限"
# Serialize safe YAML double-quoted scalars, also escape Compose dollar interpolation.
escaped=${source_path//\\/\\\\}
escaped=${escaped//\"/\\\"}
escaped=${escaped//\$/\$\$}
tmp=$(mktemp "$TRIM_APPDEST/docker/.compose.XXXXXX")
trap 'rm -f "$tmp"' EXIT
# Rewrite only the managed source and user lines. Pass values via environment
# to awk without eval or shell interpolation.
export PS5_FNOS_SOURCE_LINE="        source: \"$escaped\""
export PS5_FNOS_USER_LINE="    user: \"$TRIM_UID:$TRIM_GID\""
awk '/^        source: / {print ENVIRON["PS5_FNOS_SOURCE_LINE"]; n++; next}
     /^    user: / {print ENVIRON["PS5_FNOS_USER_LINE"]; u++; next}
     {print} END {if(n!=1 || u!=1) exit 1}' "$compose" >"$tmp" || fail "Compose managed fields not found"
command -v docker >/dev/null || fail "Docker unavailable"
docker info >/dev/null 2>&1 || fail "应用未获得 Docker 管理权限，无法应用目录配置"
docker compose -p "$project" -f "$tmp" config -q || fail "Invalid Compose configuration"
# Check container ownership before doing anything to a running project.
if docker inspect "$container" >/dev/null 2>&1; then
  actual_project=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$container")
  [ "$actual_project" = "$project" ] || fail "Docker 项目名称不一致，拒绝操作其他项目"
  actual_path=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/pkgs"}}{{.Source}}{{end}}{{end}}' "$container")
  running=$(docker inspect -f '{{.State.Running}}' "$container")
else
  actual_path=""
  running=missing
fi
chmod --reference="$compose" "$tmp"
mv -f "$tmp" "$compose"
# The installed Compose is now self-contained, also for fnOS Docker manager.
if [ "$running" = missing ] || [ "$actual_path" = "$source_path" ]; then exit 0; fi
if [ "$running" = true ]; then
  docker compose -p "$project" -f "$compose" up -d --no-deps --force-recreate --pull never || fail "目录映射重建失败"
else
  docker compose -p "$project" -f "$compose" up --no-start --no-deps --force-recreate --pull never || fail "目录映射重建失败"
fi
new_path=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/pkgs"}}{{.Source}}{{end}}{{end}}' "$container")
[ "$new_path" = "$source_path" ] || fail "目录挂载校验失败"
